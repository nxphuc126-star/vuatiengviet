rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() && request.auth.token.teacher == true;
    }

    function ownsSession() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /active_sessions/{sessionId} {
      allow read: if isTeacher() || ownsSession();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'studentName', 'currentQuestionIndex', 'totalQuestions',
          'score', 'lastUpdate', 'status', 'cheating', 'cheatingImageUrl'
        ]);

      allow update: if isTeacher() || (
        ownsSession()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentName', 'currentQuestionIndex', 'totalQuestions',
          'score', 'lastUpdate', 'status', 'cheating', 'cheatingImageUrl'
        ])
      );

      allow delete: if isTeacher() || ownsSession();
    }

    match /leaderboard/{entryId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'score', 'correct', 'total', 'timestamp'
        ]);

      allow update, delete: if isTeacher();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
